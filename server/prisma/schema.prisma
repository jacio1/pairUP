generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id
  role     String
  sessions Session[]
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  listings  Listing[]
  sentProposals SessionProposal[] @relation("ProposalSender")
  receivedProposals SessionProposal[] @relation("ProposalOwner")
}

model Listing {
  id             String   @id
  publicId       Int      @unique @default(autoincrement())
  roomId         String   @unique
  room           Room     @relation(fields: [roomId], references: [id])
  ownerSessionId Int?
  owner          Session? @relation(fields: [ownerSessionId], references: [id], onDelete: SetNull)
  authorName     String   @default("")
  title          String   @default("")
  subject        String   @default("")
  level          String   @default("")
  goal           String   @default("")
  format         String   @default("online")
  schedule       String   @default("")
  location       String   @default("")
  description    String   @default("")
  createdAt      DateTime @default(now())
  proposals      SessionProposal[]

  @@index([ownerSessionId, createdAt])
  @@index([createdAt])
}

model Room {
  id         String    @id
  generation Int       @default(0)
  listing    Listing?
  messages   Message[]
  jobs       AiJob[]
}

model SessionProposal {
  id String @id @default(uuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  senderId Int
  sender Session @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ownerId Int?
  owner Session? @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  senderName String
  status String @default("pending")
  createdAt DateTime @default(now())
  @@unique([listingId, senderId])
  @@index([ownerId, createdAt])
}

model Message {
  seq             Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  author          String
  sessionId       Int?
  kind            String   @default("human")
  text            String
  clientRequestId String   @unique
  targetMessageId String?
  createdAt       DateTime @default(now())

  @@index([roomId, seq])
}

model AiJob {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  clientRequestId String   @unique
  prompt          String
  locale          String
  targetMessageId String?
  generation      Int
  status          String   @default("pending")
  provider        String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roomId, createdAt])
}
