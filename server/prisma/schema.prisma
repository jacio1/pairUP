generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id
  role     String
  sessions Session[]
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  listings  Listing[]
  sentProposals SessionProposal[] @relation("ProposalSender")
  receivedProposals SessionProposal[] @relation("ProposalOwner")
  profile PublicProfile?
}

model PublicProfile {
  id           Int      @id @default(autoincrement())
  sessionId    Int?     @unique
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  seedKey      String?  @unique
  name         String
  bio          String   @default("")
  interests    String   @default("")
  goal         String   @default("")
  availability String   @default("")
  avatar       String   @default("violet")
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listings     Listing[]
  messages     Message[]
}

model Listing {
  id             String   @id
  publicId       Int      @unique @default(autoincrement())
  roomId         String   @unique
  room           Room     @relation(fields: [roomId], references: [id])
  ownerSessionId Int?
  owner          Session? @relation(fields: [ownerSessionId], references: [id], onDelete: SetNull)
  authorName     String   @default("")
  authorProfileId Int?
  authorProfile PublicProfile? @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  title          String   @default("")
  subject        String   @default("")
  level          String   @default("")
  goal           String   @default("")
  format         String   @default("online")
  schedule       String   @default("")
  location       String   @default("")
  description    String   @default("")
  createdAt      DateTime @default(now())
  proposals      SessionProposal[]

  @@index([ownerSessionId, createdAt])
  @@index([createdAt])
  @@index([authorProfileId, createdAt])
}

model Room {
  id         String    @id
  generation Int       @default(0)
  listing    Listing?
  messages   Message[]
  jobs       AiJob[]
  notes      StudyNote[]
  tasks      StudyTask[]
  attachments Attachment[]
  timer RoomTimer?
  board RoomBoard?
}

model RoomTimer {
  roomId String @id
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  mode String @default("focus")
  focusSeconds Int @default(1500)
  breakSeconds Int @default(300)
  longBreakSeconds Int @default(900)
  remainingMs Int @default(1500000)
  endsAt DateTime?
  completed Int @default(0)
  version Int @default(0)
}

model RoomBoard {
  roomId String @id
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  generation Int @default(0)
  version Int @default(0)
  elements Json @default("[]")
}

model StudyNote {
  id        String   @id
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title     String   @default("")
  state     Bytes
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, createdAt])
}

model StudyTask {
  id        String   @id
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, createdAt])
}

model SessionProposal {
  id String @id @default(uuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  senderId Int
  sender Session @relation("ProposalSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ownerId Int?
  owner Session? @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  senderName String
  status String @default("pending")
  createdAt DateTime @default(now())
  @@unique([listingId, senderId])
  @@index([ownerId, createdAt])
}

model Message {
  authorProfileId Int?
  authorProfile PublicProfile? @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  seq             Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  author          String
  sessionId       Int?
  kind            String   @default("human")
  text            String
  clientRequestId String   @unique
  targetMessageId String?
  createdAt       DateTime @default(now())

  attachment Attachment?

  @@index([roomId, seq])
}

model Attachment {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messageId       String?  @unique
  message         Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storageKey      String   @unique
  clientRequestId String   @unique
  name            String
  size            Int
  mime            String
  kind            String
  author          String
  createdAt       DateTime @default(now())

  @@index([roomId, createdAt])
}

model AiJob {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  clientRequestId String   @unique
  prompt          String
  locale          String
  targetMessageId String?
  generation      Int
  status          String   @default("pending")
  provider        String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roomId, createdAt])
}
